  "sheets": [
    {
      "id": "sheet_waves",
      "name": "Волны",
      "comment": "Сценарий боя: волны врагов, победа и поражение.",
      "rows": [
        {
          "id": "row_mvdqpooa7",
          "event": "on_spawn",
          "children": [],
          "then": [
            {
              "action": "start_wave",
              "params": {
                "index": "0",
                "delay": "5"
              }
            }
          ],
          "else": []
        },
        {
          "id": "row_mvdqpooa8",
          "event": "on_enemy_killed",
          "children": [],
          "condition": {
            "condition": "compare",
            "params": {
              "left": "enemies_left",
              "op": "<=",
              "right": "0"
            }
          },
          "then": [
            {
              "action": "start_wave",
              "params": {
                "index": "next",
                "delay": "8"
              }
            }
          ],
          "else": []
        },
        {
          "id": "row_mvdqpooa9",
          "event": "on_wave_started",
          "children": [],
          "condition": {
            "condition": "compare",
            "params": {
              "left": "wave",
              "op": ">",
              "right": "waves_total"
            }
          },
          "then": [
            {
              "action": "end_game",
              "params": {
                "result": "won"
              }
            }
